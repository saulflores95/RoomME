# Local Docker Postgres: pnpm db:up  (maps container 5432 -> host 5433)
# Production: Supabase pooler URL (port 6543). drizzle-kit rewrites to :5432 automatically.
POSTGRES_URL="postgresql://roomme:roomme@localhost:5433/roomme"

# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-32-char-secret"

# Optional: OAuth proxy for Expo / Vercel preview
# AUTH_REDIRECT_PROXY_URL=""

# Vercel Blob — create a store in the Vercel dashboard, then paste the token.
# Local: vercel env pull, or copy from Project → Storage → Blob → .env.local
BLOB_READ_WRITE_TOKEN=""

# Resend (free tier) — https://resend.com
RESEND_API_KEY=""
EMAIL_FROM="RoomMe <onboarding@resend.dev>"
